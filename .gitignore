.env

# Uploaded images are content, not code: like the database, they are made by
# using the site, and backed up with it rather than committed.
static/images/artworks/

# Editor/tooling scratch, not part of the project
.claude/

# Per-machine files Flask keeps outside the code: the generated session key
# (instance/secret_key) must never be committed.
instance/
